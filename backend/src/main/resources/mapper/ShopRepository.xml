<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nanitabeta.backend.repository.ShopRepository">

  <!-- 店の1件取得 -->
  <select id="searchShop" resultType="com.nanitabeta.backend.data.Shop">
    SELECT id, shop_name, area_id, shop_kind_id, is_closed
    FROM shops
    WHERE id = #{id}
  </select>

</mapper>