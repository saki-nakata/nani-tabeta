<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nanitabeta.backend.repository.CategoryRepository">

  <!-- 分類の一覧 -->
  <select id="searchCategoryList" resultType="com.nanitabeta.backend.data.Category">
    SELECT id, category_name, category_emoji
    FROM categories
    ORDER BY id
  </select>

  <!-- 分類の1件取得 -->
  <select id="searchCategory" resultType="com.nanitabeta.backend.data.Category">
    SELECT id, category_name, category_emoji
    FROM categories
    WHERE id = #{id}
  </select>

</mapper>
